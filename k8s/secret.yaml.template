# k8s/secret.yaml.template
# Copy to secret.yaml, fill in base64 values, then: kubectl apply -f k8s/secret.yaml
# Never commit secret.yaml to git.
#
# Encode a value:  echo -n "your-key-here" | base64

apiVersion: v1
kind: Secret
metadata:
  name: apply-easy-secrets
  namespace: apply-easy
type: Opaque
data:
  GROQ_API_KEY:       ""   # base64 of your key
  ANTHROPIC_API_KEY:  ""   # base64 — optional
  LINKEDIN_EMAIL:     ""   # base64 of LinkedIn login email
  LINKEDIN_PASSWORD:  ""   # base64 of LinkedIn password
  INDEED_EMAIL:       ""   # base64 of Indeed login email
  INDEED_PASSWORD:    ""   # base64 of Indeed password
